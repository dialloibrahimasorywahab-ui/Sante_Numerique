# ==============================================================================
# SANTÉ NUMÉRIQUE — MODÈLE DE CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ==============================================================================
# Instructions de déploiement :
# 1. Copiez ce fichier sous le nom '.env' : cp .env.example .env
# 2. Modifiez TOUTES les valeurs sensibles (mots de passe, clés secrètes, domaine).
# 3. Assurez-vous que les permissions du fichier .env sont restreintes (chmod 600 .env).
# 4. NE JAMAIS COMMITTER LE FICHIER .env DANS LE DÉPÔT GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# DOMAINE ET PORTS PUBLICS
# ------------------------------------------------------------------------------
# Nom de domaine public complet de l'établissement (ex: sante.hopital-universitaire.fr)
DOMAIN_NAME=sante.votre-hopital.fr

# Ports d'écoute publics du reverse-proxy Nginx
PORT_HTTP=80
PORT_HTTPS=443

# Email pour les notifications d'expiration des certificats SSL Let's Encrypt
CERTBOT_EMAIL=admin-secu@votre-hopital.fr

# ------------------------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL (DOCKER SERVICE 'db')
# ------------------------------------------------------------------------------
# Identifiants du conteneur PostgreSQL
POSTGRES_DB=sante_numerique
POSTGRES_USER=sante_user
POSTGRES_PASSWORD=definis_un_mot_de_passe_robuste_et_complexe_ici

# Paramètres de connexion Django vers le conteneur PostgreSQL
DATABASE_NAME=sante_numerique
DATABASE_USER=sante_user
DATABASE_PASSWORD=definis_un_mot_de_passe_robuste_et_complexe_ici
DATABASE_HOST=db
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# CONFIGURATION DJANGO CORE
# ------------------------------------------------------------------------------
# Clé secrète Django (OBLIGATOIRE — unique par environnement)
# Générer une clé robuste avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cle_secrete_django_a_generer_aleatoirement_et_a_ne_jamais_partager

# Mode DEBUG (IMPERATIVEMENT False en production pour éviter toute fuite d'informations)
DJANGO_DEBUG=False

# Hôtes autorisés par Django (séparés par des virgules)
# En production, spécifier le domaine du site et le nom interne du conteneur
DJANGO_ALLOWED_HOSTS=sante.votre-hopital.fr,backend,localhost,127.0.0.1

# Collecte automatique des fichiers statiques lors du démarrage du conteneur backend
COLLECT_STATIC=1

# ------------------------------------------------------------------------------
# SÉCURITÉ CSRF ET CORS
# ------------------------------------------------------------------------------
# Origines de confiance pour les requêtes POST/PUT/DELETE sous CSRF Django
CSRF_TRUSTED_ORIGINS=https://sante.votre-hopital.fr

# Origines autorisées pour les requêtes CORS
CORS_ALLOWED_ORIGINS=https://sante.votre-hopital.fr

# ------------------------------------------------------------------------------
# AUTHENTIFICATION ET SESSIONS JWT
# ------------------------------------------------------------------------------
# Durée de validité de l'access token en minutes (recommandé : 60 minutes)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Durée de validité du refresh token en jours (7 jours recommandé en contexte médical)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Sécurité des cookies JWT (HttpOnly, Secure en HTTPS)
# Doit être True en production sous HTTPS
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# EN-TÊTES DE SÉCURITÉ HTTPS DJANGO
# ------------------------------------------------------------------------------
# Activé en production derrière le proxy SSL Nginx
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

