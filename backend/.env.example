# ============================================================
# Configuration des variables d'environnement
# Copiez ce fichier en '.env' et configurez vos propres valeurs
# ============================================================

# Clé secrète Django (obligatoire — ne jamais exposer en production)
SECRET_KEY=votre_cle_secrete_securisee_ici

# Mode debug (True en développement, False en production)
DEBUG=True

# Hôtes autorisés (en production : votre(s) domaine(s) officiel(s))
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------------------------------------------------
# CORS : origines autorisées à communiquer avec l'API
# En développement, localhost:4200 est suffisant.
# En production, lister uniquement les domaines officiels.
# OBLIGATOIRE en production (aucun fallback permissif).
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# -------------------------------------------------------------------
# CSRF : origines de confiance pour les requêtes multi-domaines
# Angular doit envoyer X-CSRFToken sur toute requête mutante.
# En production, remplacer par vos domaines HTTPS officiels.
# -------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# -------------------------------------------------------------------
# Cookies JWT
# -------------------------------------------------------------------
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=False

# -------------------------------------------------------------------
# Throttling (limitation de débit)
# -------------------------------------------------------------------
THROTTLE_ANON_RATE=100/day
THROTTLE_USER_RATE=1000/day
THROTTLE_LOGIN_RATE=5/minute
