# ============================================================
# Configuration des variables d'environnement — EXEMPLE
# Copiez ce fichier en '.env' et configurez vos propres valeurs.
# NE JAMAIS COMMITTER LE FICHIER .env EN PRODUCTION.
# Ce fichier .env.example ne doit contenir AUCUN secret réel.
# ============================================================

# ==========================================
# Sécurité Django
# ==========================================
# Clé secrète Django (obligatoire — valeur unique par environnement, jamais partagée)
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changez-cette-cle-secrete-en-production-unique-et-aleatoire

# Mode debug (TOUJOURS False en production — ne jamais exposer les traces en prod)
DEBUG=False

# Liste des hôtes autorisés (remplacer * par les domaines réels en production)
# Exemple production : ALLOWED_HOSTS=mon-hopital.fr,api.mon-hopital.fr
# Exemple développement local : ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Configuration de l'authentification JWT
# ==========================================
# Durée de validité de l'access token en minutes (ex: 60 = 1 heure)
# Assure la fluidité de travail des praticiens tout en limitant la validité des tokens circulant.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Durée de validité du refresh token en jours (par défaut 7 jours)
# JUSTIFICATION DU CHOIX DE 7 JOURS (CONTEXTE MÉDICAL / HOSPITALIER) :
# Dans un établissement hospitalier, les professionnels accèdent à des données de santé
# à caractère personnel hautement sensibles (DCP, dossiers patients, prescriptions, antécédents).
# Un refresh token de 30 jours (standard web grand public) présente un risque trop élevé
# en cas de vol de session, d'oubli de déconnexion sur un poste partagé ou de compromission de poste de soins.
# La réduction à 7 jours :
# 1. Réduit drastiquement la fenêtre d'exposition en cas de fuite de jeton.
# 2. Force une ré-authentification hebdomadaire complète des soignants et personnels.
# 3. Maintient un confort opérationnel adapté au rythme de travail hospitalier (roulement d'équipes sur la semaine).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cookie sécurisé : True en production (HTTPS obligatoire), False en développement local
JWT_COOKIE_SECURE=True
# SameSite : Lax en production standard, None si cross-origin avec HTTPS
JWT_COOKIE_SAMESITE=Lax

# ==========================================
# Configuration CORS
# ==========================================
# Origines autorisées — remplacer par les origines Angular réelles en production
# Exemple production : CORS_ALLOWED_ORIGINS=https://mon-hopital.fr
# Exemple développement : CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ==========================================
# Sécurité HTTPS (production uniquement)
# ==========================================
# Activer uniquement si HTTPS est configuré et fonctionnel sur le serveur.
# Ne pas activer en développement local (le serveur Django ne gère pas HTTPS directement).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ==========================================
# Throttling (limitation de débit)
# ==========================================
THROTTLE_ANON_RATE=100/day
THROTTLE_USER_RATE=1000/day
THROTTLE_LOGIN_RATE=5/minute

# ==========================================
# Configuration des Emails
# ==========================================
# Par défaut en développement : affichage direct des e-mails dans la console du terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
# Ne jamais mettre de vraies credentials ici — utiliser les variables d'environnement du serveur
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Santé Numérique <noreply@sante-numerique.fr>

# ==========================================
# Configuration de la Base de Données PostgreSQL
# ==========================================
# IMPORTANT : PostgreSQL est OBLIGATOIRE en production et environnement hospitalier concurrent.
# SQLite n'est PAS acceptable en production (absence de verrous, contraintes conditionnelles limitées).
#
# Format URL : postgres://utilisateur:mot_de_passe@hote:port/nom_base
# Note : si votre mot de passe contient des caractères spéciaux (ex: @), URL-encodez-les (ex: @ -> %40)
# Ne jamais committer les credentials réels dans ce fichier.
DATABASE_URL=postgres://postgres:mot_de_passe_securise@localhost:5432/sante_numerique

# --- Alternative avec variables individuelles ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sante_numerique
# DB_USER=postgres
# DB_PASSWORD=mot_de_passe_securise
# DB_HOST=localhost
# DB_PORT=5432

# ==========================================
# Seeders (développement uniquement)
# ==========================================
# Mot de passe de seed des médecins — si vide, un mot de passe aléatoire est généré par compte.
# Ne jamais définir cette variable en production.
# MEDECIN_SEED_PASSWORD=
